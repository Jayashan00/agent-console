# ---------------------------------------------------------------------------
# Agent Console configuration
# Copy to .env and fill in what you need. Every value has a working default.
# ---------------------------------------------------------------------------

# Model-driven runs. Leave blank to use the built-in scripted engine, which
# drives the same loop and the same real tools without any credentials.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5

# Server
PORT=8787
HOST=0.0.0.0

# Storage (runs are JSON documents; the agent's file workspace lives here too)
# DATA_DIR=./data
# WORKSPACE_DIR=./data/workspace

# Guard rails
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS_PER_STEP=3
TOOL_TIMEOUT_MS=20000
