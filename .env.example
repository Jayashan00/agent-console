# ---------------------------------------------------------------------------
# Agent Console configuration
# Copy to .env and fill in what you need. Every value has a working default,
# and the app runs with none of them set (scripted engine, real tools).
# ---------------------------------------------------------------------------

# --- Option A: Anthropic (paid, prepaid credits, $5 minimum) ----------------
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-4-5

# --- Option B: any OpenAI-compatible provider -------------------------------
# Works with Groq, Google AI Studio, Cerebras, OpenRouter, a local Ollama, or
# OpenAI itself. Several of these issue a key with no credit card.
# Set OPENAI_API_KEY and the app switches to this transport automatically.
#
# Groq (free tier, no card):
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   AGENT_MODEL=llama-3.3-70b-versatile
#
# Google AI Studio (free tier, no card):
#   OPENAI_API_KEY=AIza...
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AGENT_MODEL=gemini-2.5-flash
#
# OpenRouter:
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Force a transport if both keys are present: anthropic | openai
# LLM_PROVIDER=

# Server
PORT=8787
HOST=0.0.0.0

# Storage (runs are JSON documents; the agent's file workspace lives here too)
# DATA_DIR=./data
# WORKSPACE_DIR=./data/workspace

# Free provider tiers meter tokens-per-minute. Every turn re-sends the working
# memory, so these two caps are what keep a long run inside a free quota.
AGENT_OBSERVATION_CHARS=1100
AGENT_MAX_OBSERVATIONS=8
LLM_MAX_RETRIES=2

# Guard rails
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS_PER_STEP=3
TOOL_TIMEOUT_MS=20000
